# .notestignore — 无测试文件的包免检列表
# 语法：一行一个包路径或 glob 模式，支持 # 注释和空行
# 随着测试覆盖率的提升，逐步移除条目
#
# 以下为无测试文件的包，暂不要求测试：

# go:embed 静态资源包（TaskUI 插件资产，无 Go 逻辑）
task/TEMPLATE/ui
task/hanime/ui
task/tktube/ui
task/urllist/ui
task/vikacg/ui

# 独立 go.mod 子模块（Playwright 测试服务端，走 node 侧测试体系）
cmd/playwright-server
cmd/playwright-server/fixture

# 测试辅助库（下游测试引用，自身无独立业务逻辑）
testutil/assert

# 纯静态资源 embed（web/embed.go 仅 go:embed 指令）
web

# 内部工具子包（scraper tunnel 客户端，随 cmd/scraper_get 使用）
pkg/scraper_tunnel
